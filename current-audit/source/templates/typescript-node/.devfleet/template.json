{
  "id": "typescript-node",
  "language": "typescript",
  "framework": "node",
  "maturity": "core",
  "bootstrap_command": "./.devfleet/bootstrap.sh",
  "format_command": "npm run format",
  "lint_command": "npm run lint && npm run typecheck",
  "test_command": "npm test",
  "health_command": "./.devfleet/health-check.sh",
