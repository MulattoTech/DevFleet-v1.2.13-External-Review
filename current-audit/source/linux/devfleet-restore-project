#!/usr/bin/env bash
set -Eeuo pipefail
project=${1:?project slug required};mode=${2:-copy};[[ "$project" =~ ^[a-z0-9][a-z0-9._-]{1,62}$ ]] || { echo invalid project >&2;exit 2; };[[ "$mode" == copy || "$mode" == --canonical ]] || { echo 'mode must be copy or --canonical' >&2;exit 2; };[[ -r /etc/devfleet/restic.env ]] || { echo backup not configured >&2;exit 3; };set -a;source /etc/devfleet/restic.env;set +a;stamp=$(date +%Y%m%d-%H%M%S);if [[ $mode == --canonical ]];then target="/home/devrunner/workspaces/$project";else target="/home/devrunner/workspaces/${project}-recovered-$stamp";fi;tmp="/home/devrunner/workspaces/.${project}.restore-$stamp.tmp";trap 'rm -rf --one-file-system -- "$tmp"' EXIT
mapfile -t snapshots < <(restic snapshots --json|jq -r 'sort_by(.time)|reverse|.[].id')
for snapshot in "${snapshots[@]}";do rm -rf --one-file-system -- "$tmp";mkdir -p "$tmp";if restic restore "$snapshot" --target "$tmp" --include "/home/devrunner/workspaces/$project/**" >/dev/null 2>&1;then source_dir="$tmp/home/devrunner/workspaces/$project";if [[ -d $source_dir ]];then if [[ $mode == --canonical && -e $target ]];then quarantine="/home/devrunner/.devfleet-quarantine/transfer-replaced-$stamp-$project";mkdir -p /home/devrunner/.devfleet-quarantine;mv "$target" "$quarantine";fi;mv "$source_dir" "$target";echo "$target";exit 0;fi;fi;done
echo 'Project was not found in any available snapshot.' >&2;exit 4
